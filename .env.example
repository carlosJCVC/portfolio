# AI agent (/ai). Copy to .env.local for `npm run dev`; set the same
# variables in the Vercel project settings for production.
# Without any key the agent runs on its built-in offline engine.

# Recommended: Groq free tier (create the key WITHOUT adding a payment method).
GROQ_API_KEY=

# Optional: Claude instead of Groq (set AI_PROVIDER=anthropic if both keys exist).
# ANTHROPIC_API_KEY=
# AI_PROVIDER=groq            # groq | anthropic

# Optional overrides
# AI_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b   # tried in order; each has its own free quota
# AI_MODEL_LABEL=GPT-OSS · Groq
# AI_REASONING_EFFORT=low     # gpt-oss only: low | medium | high
# AI_MAX_HISTORY_TURNS=4      # visitor turns sent to the model
# AI_MAX_TOKENS=4096
# AI_DAILY_LIMIT=600          # global requests per day, per instance
# AI_RATE_LIMIT_MAX=40        # requests per window, per IP and instance
# AI_RATE_LIMIT_WINDOW_MS=600000
